# Copy to .env for local Compose or development use.
# Generate the API token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_STARTER_API_TOKEN=replace-with-a-generated-token
OPENAI_API_KEY=replace-with-your-provider-key
AI_STARTER_MODEL=gpt-4o-mini
AI_STARTER_REDIS_URL=redis://localhost:6379/0
